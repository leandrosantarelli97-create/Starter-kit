# ============================================================
# Variabili d'ambiente
#
# Come si usa: copia questo file in .env.local e compila i valori
# man mano che il corso li introduce. Il file .env.local NON va mai
# committato: contiene i tuoi segreti (è già nel .gitignore).
#
# Regola d'oro: le variabili che iniziano con NEXT_PUBLIC_ finiscono
# nel browser e sono visibili a chiunque. Tutte le altre restano sul
# server. I segreti NON devono MAI avere il prefisso NEXT_PUBLIC_.
# ============================================================

# --- AI (dal Modulo 1, con provider finto) ---
# "mock" = risposte finte predefinite, nessuna API key, costo zero.
# "openai" = chiamate reali a OpenAI (si attiva nel Modulo 3).
AI_PROVIDER=mock

# --- Supabase (Modulo 2) ---
# Li trovi nel dashboard Supabase del tuo progetto:
# Project Settings → API Keys.
# NEXT_PUBLIC_SUPABASE_URL=https://tuo-progetto.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- OpenAI (Modulo 3) ---
# Prima di inserire la key: attiva il billing con limite di spesa a $10.
# OPENAI_API_KEY=sk-...

# --- Stripe (Modulo 4, solo binario SaaS) ---
# In test mode: le key le trovi nel dashboard Stripe → Developers → API keys.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Il prezzo ricorrente del Pro: 24,00 € al mese, IVA esclusa.
# STRIPE_PRICE_PRO=price_...
# L'aliquota IVA al 22%, esclusiva, creata in Stripe → Catalogo prodotti →
# Aliquote fiscali. Senza, si addebiterebbe il solo imponibile mentre il
# riepilogo promette 29,28 €.
# STRIPE_TAX_RATE_IVA=txr_...

# --- Brevo (Modulo 4, solo binario SaaS) ---
# BREVO_API_KEY=xkeysib-...
