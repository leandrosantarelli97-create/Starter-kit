# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# file di ambiente: contengono segreti, mai committarli
.env*
# .env.example è il template senza segreti: quello sì, va committato
!.env.example

# vercel
.vercel

# coding agent: i permessi che approvi sono personali, non del progetto
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts
